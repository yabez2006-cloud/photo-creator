# ---------------------------------------------------------------------------
# Real credentials - this file is git-ignored, do not commit it.
# See .env.example for every available option.
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=8853281488:AAEm_av2XRaPDNEjuf6hJtDim__LxVUVKMI

# Used by the local Bot API server (docker-compose) which lifts the
# 20 MB download / 50 MB upload limits of the official Bot API.
TELEGRAM_API_ID=36574460
TELEGRAM_API_HASH=d44f7c7c4ba11b1facb4eec33bbdcec1

# Leave these unset to talk to the official api.telegram.org directly
# (fine for short test videos).  docker-compose.yml sets them to the
# bundled local Bot API server automatically.
#TELEGRAM_API_BASE_URL=http://localhost:8081/bot
#TELEGRAM_BASE_FILE_URL=http://localhost:8081/file/bot

# Largest accepted source video, in bytes (200 MB).  Only takes effect with
# the local Bot API server (docker-compose) - Telegram's official API
# hard-caps bot downloads at 20 MB no matter what this is set to.
MAX_VIDEO_SIZE=209715200

# Largest final video the bot will send, in bytes (200 MB).  Same caveat:
# takes effect only with the local Bot API server - the official API caps
# bot uploads at 50 MB.
MAX_OUTPUT_SIZE=209715200

MAX_CONCURRENT_JOBS=1
